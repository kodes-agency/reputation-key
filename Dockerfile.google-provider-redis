# Dedicated, disposable provider-control Redis. It is intentionally not a
# Railway managed database: the application contract requires private TLS,
# a non-default ACL user, persistence/replication disabled, bounded memory,
# and denied persistence/admin commands. This image is built, scanned, signed,
# and promoted with the rest of the release candidate.
# Digest-pinned; the tag is the comment. Bumped 2026-08-29 from 7.4.7 (built
# 2026-01-28) because grype began failing this image at HIGH: the seven-month-old
# build sat eight Alpine packages behind, openssl/libcrypto3 3.3.6 among them.
# Re-pinned 2026-09-18 to the upstream 7.4.11 rebuild of 2026-09-17 (Alpine
# 3.21.8): the 2026-08-18 build shipped libssl3/libcrypto3 3.3.7-r0, and grype
# failed it at CRITICAL once its DB learned CVE-2026-63073 and four siblings;
# this build carries 3.3.7-r1. Same Redis, newer Alpine packages.
FROM redis:8.10.0-alpine@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241

ARG SOURCE_REVISION
ENV IMAGE_SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/kodes-agency/reputation-key" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.title="RepKey provider-ephemeral Redis"

COPY --chmod=0555 services/google-provider-redis/entrypoint.sh /usr/local/bin/repkey-provider-redis

ENTRYPOINT ["/usr/local/bin/repkey-provider-redis"]
