# syntax=docker/dockerfile:1
ARG SOURCE_REVISION=unknown
FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS base
ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/opt/corepack \
    PATH=/pnpm:$PATH \
    HUSKY=0
RUN mkdir -p "$COREPACK_HOME" \
    && corepack enable \
    && corepack install --global pnpm@10.6.5
WORKDIR /app
RUN node -e "const expected={node:'22.23.2',icu:'78.2',unicode:'17.0'}; for (const [key,value] of Object.entries(expected)) if (process.versions[key] !== value) throw new Error(key+' runtime drift')"

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN NODE_ENV=production pnpm build:ai-egress-gateway \
 && pnpm exec tsup --config tsup.ai-egress-gateway-runtime-assets.config.ts \
 && node dist-ai-egress-gateway-assets-test/verify-runtime-assets.js \
 && pnpm exec tsup --config tsup.ai-egress-probe.config.ts \
 && node scripts/verify-ai-egress-gateway-bundle.mjs \
 && pnpm exec tsup --config tsup.ai-egress-gateway-local.config.ts

FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS runtime
ARG SOURCE_REVISION=unknown
ENV NODE_ENV=production
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
WORKDIR /app
RUN node -e "const expected={node:'22.23.2',icu:'78.2',unicode:'17.0'}; for (const [key,value] of Object.entries(expected)) if (process.versions[key] !== value) throw new Error(key+' runtime drift')"
RUN rm -rf /opt/corepack /pnpm \
    /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /app/dist-ai-egress-gateway ./dist-ai-egress-gateway
COPY --from=build /app/dist-ai-egress-probe ./dist-ai-egress-probe
USER node
EXPOSE 8080 8443
CMD ["node", "dist-ai-egress-gateway/index.js"]

FROM runtime AS local-provider
COPY --from=build /app/dist-ai-egress-gateway-local ./dist-ai-egress-gateway-local
CMD ["node", "dist-ai-egress-gateway-local/local-provider-entry.js"]

FROM runtime AS production
