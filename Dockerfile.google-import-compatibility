# syntax=docker/dockerfile:1
ARG SOURCE_REVISION=unknown
# Frozen rollout-only Google import compatibility operator.
# This image is not a web or worker service and must never receive traffic.
# Promote and retain it by immutable image digest until contract cutover.

FROM node:26-slim@sha256:c0753125a3789977aefe869cbebccf70e3cfd7ea84ca48547458f02e4f1d7146 AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    HUSKY=0
RUN corepack enable
WORKDIR /app
RUN node -e "const expected={node:'22.23.2',icu:'78.2',unicode:'17.0'}; for (const [key,value] of Object.entries(expected)) if (process.versions[key] !== value) throw new Error(key+' runtime drift')"

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm build:google-import-compatibility \
 && node scripts/check-google-import-artifacts.mjs compatibility dist-google-import-compatibility

FROM base AS prod-deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

FROM base AS compatibility
ARG SOURCE_REVISION
ENV NODE_ENV=production \
    IMAGE_SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
      com.repkey.google-import-contract=compatibility \
      com.repkey.rollout-scope=google-import-only
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /app/dist-google-import-compatibility ./dist-google-import-compatibility
COPY --from=prod-deps /app/node_modules ./node_modules
COPY package.runtime.json ./package.json
USER node
ENTRYPOINT ["node", "dist-google-import-compatibility/google-import-lifecycle.js"]
CMD ["inspect"]
