# BQC-7.1 — Docker build context. Everything the image needs is copied
# explicitly in the Dockerfiles; keep the context small and never ship env.
.git
node_modules
.output
dist
dist-*
storybook-static
coverage
test-results
playwright-report
# Legal notices are build inputs of the /privacy routes; keep other docs out.
docs/*
!docs/legal
e2e
e2e/.certs
review
.storybook
.tanstack
.vscode
.local-stack
.husky
.claude
.codex
.fallow
.od-skills
.omp
.pi
.superpowers
.a5c
.github
.DS_Store
*.local
.env
.env.*
!.env.example
npm-debug.log*
