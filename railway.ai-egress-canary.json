{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.ai-egress-gateway"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0,
    "startCommand": "node dist-ai-egress-gateway/canary.js"
  }
}
