{
  "name": "reputation-key",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development vite dev --port 3000",
    "dev:worker": "tsx src/worker/index.ts",
    "build": "vite build && tsup",
    "clean": "rm -rf .output dist dist-worker storybook-static coverage test-results",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && pnpm check:typescript-project-coverage",
    "local:doctor": "node scripts/local-doctor.mjs",
    "lint": "eslint . && node scripts/check-architecture-boundary-controls.mjs && node scripts/check-filenames.mjs && node scripts/check-component-boundaries.mjs && pnpm check:product-state-consistency",
    "lint:ci": "pnpm lint && node scripts/check-test-quality.mjs && node scripts/check-google-provider-identifiers.mjs && pnpm check:runtime-environment-contract",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest --project=unit",
    "test:e2e": "playwright test",
    "test:e2e:compatibility": "playwright test --project=compat-firefox --project=compat-webkit --project=compat-mobile-android --project=compat-mobile-ios",
    "e2e:stack:up": "set -a && . ./e2e/stack.env && set +a && scripts/e2e/gen-certs.sh && docker compose -f compose.local.yml --env-file e2e/stack.env up -d --wait postgres redis provider-sandbox ai-provider-stub mail-stub && REVIEW_PROVIDER_SUBJECT_HMAC_MIGRATOR_KEYS=\"$MIGRATOR_REVIEW_PROVIDER_SUBJECT_HMAC_KEYS\" DEPLOY_MIGRATE=1 pnpm db:migrate-deploy && LOCAL_TOOL_EXECUTION_IDENTITY=\"$HOST_LOCAL_TOOL_EXECUTION_IDENTITY\" pnpm seed:e2e-user && docker compose -f compose.local.yml --env-file e2e/stack.env up -d --wait web web-locked && docker compose -f compose.local.yml --env-file e2e/stack.env up -d worker && scripts/e2e/wait-worker.sh",
    "e2e:stack:logs": "mkdir -p test-results/local-stack && docker compose -f compose.local.yml --env-file e2e/stack.env logs --no-color --timestamps > test-results/local-stack/compose.log",
    "e2e:stack:down": "docker compose -f compose.local.yml --env-file e2e/stack.env down -v --remove-orphans",
    "seed:e2e-user": "tsx scripts/seed-e2e-user.ts",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-drizzle.ts",
    "db:migrate-deploy": "tsx scripts/migrate-deploy.ts",
    "auth:migrate": "tsx scripts/better-auth-schema.ts",
    "audit:auth-schema": "node --env-file-if-exists=.env scripts/verify-auth-schema.mjs",
    "start": "node --import ./.output/server/web-observability-preload.mjs .output/server/index.mjs",
    "start:worker": "node --import ./dist-worker/worker-observability-preload.js dist-worker/index.js",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "REPKEY_STORYBOOK_TESTS=true vitest run --project=storybook",
    "perf:catalog": "tsx scripts/perf/load-test.ts --list",
    "perf:run": "tsx scripts/perf/load-test.ts",
    "perf:seed-scale": "tsx scripts/perf/seed-scale.ts",
    "perf:evidence": "tsx scripts/perf/write-scale-evidence.ts",
    "perf:cell": "tsx scripts/perf/staging-cell.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:bundles": "node scripts/check-bundle-budget.mjs",
    "check:production-artifacts": "node scripts/check-production-artifacts.mjs",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:language-verifier": "node scripts/check-runtime-language-verifier.mjs",
    "check:changed-code": "node scripts/check-changed-code.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:container-images": "tsx scripts/ci/check-container-image-policy.ts",
    "check:typescript-project-coverage": "tsx scripts/ci/check-typescript-project-coverage.ts",
    "check:product-state-consistency": "tsx scripts/ci/check-product-state-consistency.ts",
    "check:runtime-environment-contract": "tsx scripts/ci/check-runtime-environment-contract.ts",
    "ops": "tsx scripts/ops/index.ts",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@sentry/node": "10.73.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.3",
    "bullmq": "6.3.4",
    "class-variance-authority": "^0.7.1",
    "cld3-asm": "4.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "fractional-indexing": "^4.0.0",
    "ioredis": "5.11.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "^1.41.0",
    "openai": "7.4.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.3.6",
    "undici": "8.10.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@sentry/tanstackstart-react": "10.73.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "~10.6.0",
    "@storybook/addon-vitest": "~10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "fallow": "3.22.0",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "nitro": "^3.0.260429-beta",
    "opencc-js": "1.4.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "shadcn": "4.20.1",
    "storybook": "10.6.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "hono": "4.12.34",
      "js-yaml": "4.3.1",
      "kysely": "0.28.17",
      "nanoid": "3.3.18",
      "playwright": "$@playwright/test",
      "playwright-core": "$@playwright/test",
      "postcss": "8.5.23",
      "valibot": "1.4.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "pino"
    ]
  }
}
