{
  "name": "reputation-key",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development vite dev --port 3000",
    "dev:worker": "tsx src/worker/index.ts",
    "dev:all": "concurrently -n web,worker -c blue,green \"pnpm dev\" \"pnpm dev:worker\"",
    "build": "vite build",
    "build:worker": "tsup",
    "build:google-import-compatibility": "tsup --config tsup.google-import-compatibility.config.ts",
    "build:ai-execution-admission": "tsup --config tsup.ai-execution-admission.config.ts",
    "build:ai-egress-gateway": "tsup --config tsup.ai-egress-gateway.config.ts",
    "build:google-execution-admission": "tsup --config tsup.google-execution-admission.config.ts",
    "build:google-egress-gateway": "tsup --config tsup.google-egress-gateway.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-filenames.mjs && node scripts/check-component-boundaries.mjs && node scripts/check-test-quality.mjs && pnpm check:google-provider-fixtures && pnpm check:ai-contract-attestations && pnpm check:ai-governance-artifacts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest --project=unit",
    "test:e2e": "playwright test",
    "test:e2e:local": "tsx scripts/local-stack/stack.ts test --mode=e2e",
    "e2e:stack:up": "tsx scripts/local-stack/stack.ts up --mode=e2e",
    "e2e:stack:smoke": "tsx scripts/local-stack/stack.ts smoke --mode=e2e",
    "e2e:stack:logs": "tsx scripts/local-stack/stack.ts logs --mode=e2e",
    "e2e:stack:down": "tsx scripts/local-stack/stack.ts down --mode=e2e",
    "local:stack:up": "tsx scripts/local-stack/stack.ts up --mode=e2e",
    "local:stack:smoke": "tsx scripts/local-stack/stack.ts smoke --mode=e2e",
    "local:stack:logs": "tsx scripts/local-stack/stack.ts logs --mode=e2e",
    "local:stack:down": "tsx scripts/local-stack/stack.ts down --mode=e2e",
    "local:beta:up": "tsx scripts/local-stack/stack.ts up --mode=beta",
    "local:beta:down": "tsx scripts/local-stack/stack.ts down --mode=beta",
    "seed:e2e-user": "tsx scripts/seed-e2e-user.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:simulate": "tsx scripts/seed.ts -- --invariants",
    "simulate": "tsx scripts/simulate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-drizzle.ts",
    "db:migrate-deploy": "tsx scripts/migrate-deploy.ts",
    "db:google-property-binding-index": "tsx scripts/google-property-binding-index.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx -y dotenv-cli -- npx -y @better-auth/cli generate --config src/shared/auth/auth-cli.ts",
    "auth:migrate": "npx -y dotenv-cli -- npx -y @better-auth/cli migrate --config src/shared/auth/auth-cli.ts",
    "db:bootstrap-auth": "npx -y dotenv-cli -- bash -c 'psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/migrations/0000-auth-tables-bootstrap.sql'",
    "db:matviews": "npx -y dotenv-cli -- bash -c 'psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/migrations/add-materialized-views-and-gbp-index.sql'",
    "audit:member-roles": "tsx scripts/audit-member-roles.ts",
    "audit:auth-schema": "npx -y dotenv-cli -- node scripts/verify-auth-schema.mjs",
    "start": "node .output/server/index.mjs",
    "start:worker": "node dist-worker/index.js",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --failOnConsole",
    "test:storybook": "VITEST_STORYBOOK=true vitest run --project='storybook:**'",
    "perf:catalog": "tsx scripts/perf/load-test.ts --list",
    "perf:run": "tsx scripts/perf/load-test.ts",
    "perf:seed-scale": "tsx scripts/perf/seed-scale.ts",
    "perf:seed-fleet": "tsx scripts/perf/seed-fleet.ts",
    "perf:evidence": "tsx scripts/perf/write-scale-evidence.ts",
    "perf:cell": "tsx scripts/perf/staging-cell.ts",
    "beta:smoke": "tsx scripts/beta/smoke.ts",
    "beta:create-pre-cutover-dump": "tsx scripts/beta/create-pre-cutover-dump.ts",
    "bqc:validate-status": "tsx scripts/bqc/validate-status.ts",
    "bqc:generate-status": "tsx scripts/bqc/generate-status.ts",
    "release:validate-evidence": "tsx scripts/release/validate-bundle.ts",
    "release:promote-local-evidence": "tsx scripts/release/promote-local-evidence.ts",
    "bqc:run-baseline": "tsx scripts/bqc/run-baseline.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:bundles": "node scripts/check-bundle-budget.mjs",
    "check:google-import-artifacts": "node scripts/check-google-import-artifacts.mjs",
    "generate:google-provider-fixtures": "tsx scripts/generate-google-provider-fixtures.ts",
    "check:google-provider-fixtures": "tsx scripts/generate-google-provider-fixtures.ts --check && node scripts/check-google-provider-identifiers.mjs",
    "generate:ai-governance-artifacts": "tsx scripts/generate-ai-governance-artifacts.ts",
    "check:ai-governance-artifacts": "tsx scripts/generate-ai-governance-artifacts.ts --check",
    "check:ai-contract-attestations": "tsx scripts/check-ai-contract-attestations.ts",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:language-verifier": "node scripts/check-runtime-language-verifier.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:changed-code": "node scripts/check-changed-code.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:test-quality": "node scripts/check-test-quality.mjs",
    "ops:queue": "tsx scripts/ops/queue-quarantine.ts",
    "ops:quarantine": "tsx scripts/ops/quarantine-redrive.ts",
    "ops:reconcile-grants": "tsx scripts/ops/reconcile-staff-grants.ts",
    "ops:reconcile-regions": "tsx scripts/ops/reconcile-regions.ts",
    "ops:reconcile-people-team": "tsx scripts/ops/reconcile-people-team.ts",
    "ops:rebuild-projection": "tsx scripts/ops/rebuild-projection.ts",
    "ops:reconcile-publication": "tsx scripts/ops/reconcile-publication.ts",
    "ops:refresh": "tsx scripts/ops/enqueue-refresh.ts",
    "ops:purge": "tsx scripts/ops/enqueue-purge.ts",
    "ops:suspend-property": "tsx scripts/ops/property-suspension.ts suspend",
    "ops:restore-property": "tsx scripts/ops/property-suspension.ts restore",
    "ops:inspect": "tsx scripts/ops/inspect-decision.ts",
    "ops:disconnect-connection": "tsx scripts/ops/disconnect-connection.ts",
    "ops:gbp-subscribe": "tsx scripts/ops/gbp-subscribe.ts",
    "ops:restore-preflight": "tsx scripts/ops/restore-preflight.ts",
    "ops:restore-verify": "tsx scripts/ops/restore-verify.ts",
    "ops:google-content-approval": "tsx scripts/ops/google-content-approval.ts",
    "ops:google-content-approval-sign": "tsx scripts/ops/google-content-approval-sign.ts",
    "ops:google-import-lifecycle": "tsx scripts/ops/google-import-lifecycle.ts",
    "release:google-import-drill": "tsx scripts/local-stack/google-import-release-drill.ts",
    "ops:ai-canary": "tsx scripts/ops/ai-canary-authorization.ts",
    "ops:ai-control": "tsx scripts/ops/ai-execution-control.ts",
    "ops:permit-start-deadline-fence": "tsx scripts/ops/permit-start-deadline-backfill.ts",
    "ops:property-capabilities": "tsx scripts/ops/property-capabilities.ts",
    "ops:reparse-review-translations": "tsx scripts/ops/reparse-review-translations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@rolldown/binding-darwin-arm64": "^1.2.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.30",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "1.168.47",
    "better-auth": "^1.6.13",
    "bullmq": "^5.75.2",
    "class-variance-authority": "^0.7.1",
    "cld3-asm": "4.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "fractional-indexing": "^4.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.9",
    "libphonenumber-js": "1.13.11",
    "lucide-react": "^1.32.0",
    "neverthrow": "^8.2.0",
    "openai": "7.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "resend": "^6.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.3.6",
    "undici": "8.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "~10.5.9",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "~10.5.9",
    "@storybook/react": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-security": "4.0.1",
    "fallow": "^3.17.0",
    "fast-check": "4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nitro": "^3.0.260429-beta",
    "opencc-js": "1.4.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.3",
    "storybook": "^10.5.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17",
      "hono": "4.12.30",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "playwright": "$@playwright/test",
      "playwright-core": "$@playwright/test"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "pino"
    ]
  }
}
