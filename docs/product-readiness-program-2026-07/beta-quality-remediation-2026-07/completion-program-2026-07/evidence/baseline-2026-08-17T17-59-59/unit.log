+     IF jsonb_typeof(v_vector) <> 'object'
+       OR v_vector->>'reviewedAt' IS NULL
+       OR v_vector->>'timezone' IS NULL
+       OR v_vector->>'expectedLocalDate' !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
+       OR (SELECT count(*) FROM jsonb_object_keys(v_vector)) <> 3
+     THEN
