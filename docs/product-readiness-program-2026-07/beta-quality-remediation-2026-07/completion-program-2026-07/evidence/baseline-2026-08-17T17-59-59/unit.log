+ CREATE OR REPLACE FUNCTION "advance_ai_aggregate_revision_v1"(
+   p_organization_id text,
+   p_property_id uuid,
+   p_source_epoch integer,
+   p_review_analysis_epoch integer,
+   p_analysis_sequence bigint,
