+     );
+     IF v_actual IS NULL OR v_actual::text <> v_vector->>'expectedLocalDate' THEN
+       RETURN false;
+     END IF;
+   END LOOP;
+   RETURN true;
+ EXCEPTION
+   WHEN OTHERS THEN RETURN false;
+ END;
