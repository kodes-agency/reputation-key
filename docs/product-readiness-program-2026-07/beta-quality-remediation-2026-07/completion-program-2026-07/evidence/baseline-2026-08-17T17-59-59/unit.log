+         AND NEW.state IN ('eligible', 'in_flight')
+         AND NEW.next_authorization_generation = OLD.next_authorization_generation
+       )
+       OR (
+         OLD.state = 'in_flight'
+         AND NEW.state IN ('eligible', 'passed', 'terminal_failed')
+         AND NEW.next_authorization_generation = OLD.next_authorization_generation
+       )
+     )
