+     OR public.resolve_ai_property_local_date_v1(
+       '2026-01-01T00:00:00Z'::timestamp with time zone,
+       'UTC',
+       'property-calendar-v1'
+     ) IS NULL
+   THEN
+     RETURN false;
+   END IF;
+
+   FOR v_vector IN
+     SELECT value FROM jsonb_array_elements(v_authority.test_vectors)
