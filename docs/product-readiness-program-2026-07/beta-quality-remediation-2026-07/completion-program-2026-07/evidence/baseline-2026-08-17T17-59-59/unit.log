+ CREATE OR REPLACE FUNCTION "settle_ai_review_analysis_outcome_v1"(
+   p_organization_id text,
+   p_property_id uuid,
+   p_source_epoch integer,
+   p_review_analysis_epoch integer,
+   p_analysis_sequence bigint,
+   p_state text,
+   p_operation_id uuid,
