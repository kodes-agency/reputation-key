# syntax=docker/dockerfile:1
ARG SOURCE_REVISION=unknown
# BQC-8 — private target-cell runner. It carries prebuilt deterministic
# seed/load CLIs so they run from inside the target's private DB/Redis network.
# It exposes no HTTP surface; Railway SSH is the sole execution channel. Source,
# TypeScript runners, package managers, and devDependencies stay in build stages.
FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS base
# CVE-2026-86145: the one High in this base with a fix. Pinned exact so the build
# fails loudly if the archive stops carrying it. Kept identical to the block in
# `Dockerfile` on purpose — these images declare their own `FROM` rather than
# deriving from that file's `base` stage, so each needs its own copy. That is
# also why the first attempt at this fix only cleared the `web` image group.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpcre2-8-0=10.42-1+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/opt/corepack \
    PATH=/pnpm:$PATH \
    HUSKY=0

RUN mkdir -p "$COREPACK_HOME" \
    && corepack enable \
    && corepack install --global pnpm@10.6.5
WORKDIR /app
RUN node -e "const expected={node:'22.23.2',icu:'78.2',unicode:'17.0'}; for (const [key,value] of Object.entries(expected)) if (process.versions[key] !== value) throw new Error(key+' runtime drift')"

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS runner
COPY . .
RUN pnpm exec tsup \
      scripts/perf/load-test.ts \
      scripts/perf/seed-scale.ts \
      scripts/perf/seed-fleet.ts \
      scripts/perf/write-scale-evidence.ts \
      scripts/local-stack/fault-operation.ts \
      --format esm \
      --platform node \
      --target node22 \
      --out-dir dist-perf-runner \
      --clean

FROM base AS prod-deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

FROM base AS runtime
ARG SOURCE_REVISION
ENV NODE_ENV=production \
    IMAGE_SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
RUN rm -rf /opt/corepack /pnpm \
    /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=runner --chown=node:node /app/dist-perf-runner ./dist-perf-runner
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.runtime.json ./package.json
COPY --chown=node:node drizzle ./drizzle
USER node

# A deployment is intentionally inert until a named Railway SSH operator runs
# a documented seed/load command. It has no public domain or HTTP listener.
CMD ["sleep", "infinity"]
