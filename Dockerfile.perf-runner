# syntax=docker/dockerfile:1
ARG SOURCE_REVISION=unknown
# BQC-8 — private target-cell runner. It carries the existing deterministic
# seed/load CLIs so they run from inside the target's private DB/Redis network.
# It exposes no HTTP surface; Railway SSH is the sole execution channel.
FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS base

ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/opt/corepack \
    PATH=/pnpm:$PATH \
    HUSKY=0

RUN mkdir -p "$COREPACK_HOME" \
    && corepack enable \
    && corepack install --global pnpm@10.6.5
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS runner
ARG SOURCE_REVISION
ENV NODE_ENV=production \
    IMAGE_SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --chown=node:node tsconfig.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node drizzle ./drizzle
COPY --chown=node:node scripts/perf ./scripts/perf
COPY --chown=node:node scripts/local-stack/fault-operation.ts ./scripts/local-stack/fault-operation.ts
USER node

# A deployment is intentionally inert until a named Railway SSH operator runs
# a documented seed/load command. It has no public domain or HTTP listener.
CMD ["sleep", "infinity"]
