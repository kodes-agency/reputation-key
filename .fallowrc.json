{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/router.tsx",
    "src/start.ts",
    "src/worker/index.ts",
    "src/bootstrap.ts",
    "src/composition.ts",
    "scripts/cleanup-kodes.ts",
    "scripts/check-db.ts",
    "scripts/check-schema-drift.ts",
    "scripts/cleanup-all.ts",
    "scripts/ai-language-attestation.ts",
    "scripts/beta/run-product-journeys.ts",
    "scripts/beta/verify-gate-evidence.ts",
    "scripts/generate-ai-language-script-table.ts",
    "scripts/generate-ai-reply-language-profile.ts",
    "scripts/generate-ai-review-language-profile.ts",
    "scripts/generate-ai-review-language-regions.ts",
    "scripts/generate-ai-unicode-case-folding.ts",
    "scripts/generate-ai-zh-orthography-table.ts",
    "scripts/google-import-final-schema-probe.ts",
    "scripts/local-stack/provision-ai-admission-role.ts",
    "scripts/migrations/null-inbox-source-copies.ts",
    "scripts/ops/report-people-authority.ts",
    "scripts/ops/report-portal-access-artifacts.ts",
    "scripts/seed-demo-reviews.ts",
    "scripts/test-db-setup.ts",
    "scripts/verify-ai-gateway-runtime-assets.ts",
    "scripts/verify-ai-runtime-image.mjs",
    "vite.config.ts",
    "drizzle.config.ts",
    "services/ai-egress-gateway/canary-entry.ts",
    "services/ai-egress-gateway/index.ts",
    "services/ai-egress-gateway/local-provider-entry.ts",
    "services/ai-egress-gateway/runtime-egress-probe.ts",
    "services/ai-execution-admission/entry.ts",
    "services/ai-execution-admission/index.ts",
    "services/google-egress-gateway/control-proxy.ts",
    "services/google-egress-gateway/entry.ts",
    "services/google-egress-gateway/index.ts",
    "services/google-egress-gateway/tcp-relay.ts",
    "services/google-execution-admission/entry.ts",
    "services/google-execution-admission/index.ts",
    "tsup.ai-egress-gateway-local.config.ts",
    "tsup.ai-egress-gateway-runtime-assets.config.ts",
    "tsup.ai-egress-probe.config.ts"
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "drizzle/**",
    "dist/**",
    "dist-worker/**",
    ".output/**",
    "e2e/**",
    "docs/**",
    ".claude/**",
    "src/shared/testing/**"
  ],
  "ignoreDependencies": [
    "@rolldown/binding-darwin-arm64",
    "@tanstack/intent",
    "@better-auth/cli",
    "@tanstack/start-server-core",
    "eslint-import-resolver-typescript",
    "pino-pretty",
    "shadcn",
    "@tailwindcss/typography",
    "opencc-js"
  ],
  "ignoreExports": [
    {
      "file": "src/shared/config/local-stack-contract.ts",
      "exports": ["SEED_BETA_CAPABILITIES"]
    },
    {
      "file": "src/routes/api/auth/$.ts",
      "exports": ["handleAuthRequest"]
    },
    {
      "file": "src/contexts/*/infrastructure/jobs/*.job.ts",
      "exports": ["JOB_NAME"]
    },
    {
      "file": "src/shared/jobs/*.job.ts",
      "exports": ["JOB_NAME"]
    },
    {
      "file": "src/contexts/identity/server/organizations.*.ts",
      "exports": [
        "updateOrganization",
        "finalizeAvatarUpload",
        "finalizeOrgLogoUpload",
        "requestAvatarUpload",
        "requestOrgLogoUpload"
      ]
    },
    {
      "file": "src/contexts/inbox/domain/constructors.ts",
      "exports": ["createInboxItem", "CreateInboxItemInput"]
    },
    {
      "file": "src/contexts/*/infrastructure/adapters/db-user-lookup.adapter.ts",
      "exports": ["createDbUserLookupAdapter"]
    },
    {
      "file": "src/contexts/integration/infrastructure/handlers/gbp-notification-handler.ts",
      "exports": ["handleGbpNotification"]
    },
    {
      "file": "src/shared/db/schema/auth.ts",
      "exports": ["member", "organization", "session", "account", "verification"]
    },
    {
      "file": "src/contexts/*/domain/errors.ts",
      "exports": ["isActivityError", "isLeaderboardError", "isMetricError"]
    },
    {
      "file": "src/contexts/activity/server/activity.ts",
      "exports": ["getOrgActivityFn"]
    },
    {
      "file": "src/contexts/inbox/server/inbox-queries.ts",
      "exports": ["stampLastInboxViewFn"]
    },
    {
      "file": "src/contexts/inbox/server/inbox-item-actions.ts",
      "exports": ["assignInboxItemFn"]
    },
    {
      "file": "src/contexts/identity/server/auth-settings.org.ts",
      "exports": ["createOrganizationFn"]
    },
    {
      "file": "src/contexts/integration/server/google-connections.ts",
      "exports": ["connectGoogle", "updateConnectionVisibility"]
    },
    {
      "file": "src/contexts/property/server/properties.ts",
      "exports": ["createProperty", "updateProperty"]
    },
    {
      "file": "src/contexts/goal/server/goals.ts",
      "exports": ["updateGoal"]
    },
    {
      "file": "src/contexts/portal/server/portal-groups.ts",
      "exports": [
        "createPortalGroup",
        "updatePortalGroup",
        "getPortalGroup",
        "softDeletePortalGroup",
        "addPortalToGroup",
        "removePortalFromGroup"
      ]
    },
    {
      "file": "src/components/hooks/web-vitals.ts",
      "exports": ["setVitalsReporter"]
    },
    {
      "file": "scripts/ops/operator-command.ts",
      "exports": ["runOperatorCommand"]
    },
    {
      "file": "src/shared/ops/operator-command.ts",
      "exports": ["runOperatorCommand"]
    },
    {
      "file": "src/shared/bqc/status-schema.ts",
      "exports": [
        "BQC_STATES",
        "bqcStateSchema",
        "bqcEntrySchema",
        "bqcStatusManifestSchema"
      ]
    },
    {
      "file": "src/contexts/*/application/public-api.ts",
      "exports": [
        "badgeAwarded",
        "goalCompleted",
        "guestScanRecorded",
        "guestRatingSubmitted",
        "guestFeedbackSubmitted",
        "guestReviewLinkClicked",
        "identityOrganizationCreated",
        "identityMemberInvited",
        "identityInvitationAccepted",
        "identityInvitationCanceled",
        "identityMemberRemoved",
        "identityMemberRoleChanged",
        "isInboxError",
        "integrationGoogleAccountConnected",
        "integrationGoogleAccountDisconnected",
        "URGENT_TYPES",
        "isUrgent",
        "notificationError",
        "propertyCreated",
        "reviewCreated",
        "reviewUpdated",
        "reviewExpired",
        "reviewReplyPublished",
        "reviewReplySubmitted",
        "reviewReplyApproved",
        "reviewReplyRejected",
        "reviewReplyPublishFailed",
        "reviewReplyUpdated",
        "reviewReplyPublicationCancelled",
        "staffAssigned",
        "staffUnassigned",
        "teamCreated",
        "teamDeleted",
        "teamUpdated"
      ]
    }
  ],
  "production": false,
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "unused-files": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-exports": "warn",
    "unused-types": "off"
  },
  "overrides": [
    {
      "files": [
        "server/plugins/production-secret-guard.ts",
        "server/plugins/redis-runtime-guard.ts",
        "server/plugins/release-identity-guard.ts",
        "server/plugins/restore-mode-guard.ts",
        "server/plugins/security-headers.ts",
        "server/plugins/request-guard.ts",
        "server/plugins/graceful-shutdown.ts",
        "server/plugins/error-monitoring.ts",
        "src/shared/observability/web-observability-preload.ts",
        "src/shared/observability/worker-observability-preload.ts",
        "src/contexts/identity/server/auth-settings.org.ts",
        "src/contexts/identity/server/organizations.roles.ts",
        "src/contexts/identity/server/policy-admin.ts",
        "src/contexts/identity/server/merchant-ai.ts",
        "src/contexts/property/server/region-move.ts"
      ],
      "rules": {
        "unused-files": "off"
      }
    },
    {
      "files": [
        "src/contexts/badge/application/public-api.ts",
        "src/contexts/badge/build.ts",
        "src/contexts/leaderboard/build.ts",
        "src/contexts/team/application/public-api.ts",
        "src/contexts/team/build.ts"
      ],
      "rules": {
        "unused-files": "off",
        "unused-exports": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "unused-exports": "off",
        "unused-types": "off"
      }
    },
    {
      "files": ["**/*.dto.ts", "**/domain/events.ts"],
      "rules": {
        "unused-types": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 10
  },
  "health": {
    "maxCyclomatic": 22,
    "maxCognitive": 15,
    "maxCrap": 450
  },
  "audit": {
    "gate": "new-only"
  },
  "boundaries": {
    "zones": [
      {
        "name": "domain",
        "patterns": ["src/contexts/*/domain/**"]
      },
      {
        "name": "application",
        "patterns": ["src/contexts/*/application/**"]
      },
      {
        "name": "infrastructure",
        "patterns": ["src/contexts/*/infrastructure/**"]
      },
      {
        "name": "server",
        "patterns": ["src/contexts/*/server/**"]
      },
      {
        "name": "shared-events",
        "patterns": ["src/shared/events/**"]
      },
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "routes",
        "patterns": ["src/routes/**"]
      },
      {
        "name": "components",
        "patterns": ["src/components/**"]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": ["shared", "shared-events"]
      },
      {
        "from": "application",
        "allow": ["domain", "shared", "shared-events"]
      },
      {
        "from": "infrastructure",
        "allow": ["domain", "application", "shared", "shared-events"]
      },
      {
        "from": "server",
        "allow": ["application", "domain", "shared", "shared-events"]
      },
      {
        "from": "shared-events",
        "allow": ["domain", "shared"]
      },
      {
        "from": "shared",
        "allow": ["shared-events"]
      }
    ]
  },
  "regression": {
    "baseline": {
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
