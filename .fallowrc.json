{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/router.tsx",
    "src/start.ts",
    "src/worker/index.ts",
    "src/bootstrap.ts",
    "src/composition.ts",
    "scripts/cleanup-kodes.ts",
    "scripts/check-db.ts",
    "scripts/check-schema-drift.ts",
    "scripts/cleanup-all.ts",
    "vite.config.ts",
    "drizzle.config.ts"
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "drizzle/**",
    "dist/**",
    "dist-worker/**",
    ".output/**",
    "e2e/**",
    "docs/**",
    ".claude/**",
    "src/shared/testing/**",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "@rolldown/binding-darwin-arm64",
    "@tanstack/intent",
    "@better-auth/cli",
    "@tanstack/start-server-core",
    "eslint-import-resolver-typescript",
    "shadcn",
    "@tailwindcss/typography"
  ],
  "ignoreExports": [
    { "file": "src/contexts/*/infrastructure/jobs/*.job.ts", "exports": ["JOB_NAME"] },
    { "file": "src/shared/jobs/*.job.ts", "exports": ["JOB_NAME"] },
    {
      "file": "src/contexts/identity/server/organizations.*.ts",
      "exports": [
        "updateOrganization",
        "finalizeAvatarUpload",
        "finalizeOrgLogoUpload",
        "requestAvatarUpload",
        "requestOrgLogoUpload"
      ]
    },
    {
      "file": "src/contexts/inbox/domain/constructors.ts",
      "exports": ["createInboxItem", "CreateInboxItemInput"]
    },
    {
      "file": "src/contexts/*/infrastructure/adapters/db-user-lookup.adapter.ts",
      "exports": ["createDbUserLookupAdapter"]
    },
    {
      "file": "src/contexts/integration/infrastructure/handlers/gbp-notification-handler.ts",
      "exports": ["handleGbpNotification"]
    },
    {
      "file": "src/shared/db/schema/auth.ts",
      "exports": ["member", "organization", "session", "account", "verification"]
    },
    {
      "file": "src/contexts/*/domain/errors.ts",
      "exports": ["isActivityError", "isLeaderboardError", "isMetricError"]
    },
    {
      "file": "src/contexts/activity/server/activity.ts",
      "exports": ["getOrgActivityFn"]
    },
    {
      "file": "src/contexts/inbox/server/inbox-queries.ts",
      "exports": ["stampLastInboxViewFn"]
    },
    {
      "file": "src/contexts/inbox/server/inbox-item-actions.ts",
      "exports": ["assignInboxItemFn"]
    },
    {
      "file": "src/contexts/identity/server/auth-settings.org.ts",
      "exports": ["createOrganizationFn"]
    },
    {
      "file": "src/contexts/integration/server/google-connections.ts",
      "exports": ["connectGoogle", "updateConnectionVisibility"]
    },
    {
      "file": "src/contexts/property/server/properties.ts",
      "exports": ["createProperty", "updateProperty"]
    },
    {
      "file": "src/contexts/goal/server/goals.ts",
      "exports": ["updateGoal"]
    },
    {
      "file": "src/contexts/portal/server/portal-groups.ts",
      "exports": [
        "createPortalGroup",
        "updatePortalGroup",
        "getPortalGroup",
        "softDeletePortalGroup",
        "addPortalToGroup",
        "removePortalFromGroup"
      ]
    },
    {
      "file": "src/components/hooks/web-vitals.ts",
      "exports": ["setVitalsReporter"]
    },
    {
      "file": "src/shared/observability/telemetry.ts",
      "exports": ["initObservability"]
    },
    {
      "file": "src/shared/bqc/status-schema.ts",
      "exports": [
        "BQC_STATES",
        "bqcStateSchema",
        "bqcEntrySchema",
        "bqcStatusManifestSchema"
      ]
    },
    {
      "file": "src/contexts/*/application/public-api.ts",
      "exports": [
        "badgeAwarded",
        "goalCompleted",
        "guestScanRecorded",
        "guestRatingSubmitted",
        "guestFeedbackSubmitted",
        "guestReviewLinkClicked",
        "identityOrganizationCreated",
        "identityMemberInvited",
        "identityInvitationAccepted",
        "identityInvitationCanceled",
        "identityMemberRemoved",
        "identityMemberRoleChanged",
        "isInboxError",
        "integrationGoogleAccountConnected",
        "integrationGoogleAccountDisconnected",
        "URGENT_TYPES",
        "isUrgent",
        "notificationError",
        "propertyCreated",
        "reviewCreated",
        "reviewUpdated",
        "reviewExpired",
        "reviewReplyPublished",
        "reviewReplySubmitted",
        "reviewReplyApproved",
        "reviewReplyRejected",
        "reviewReplyPublishFailed",
        "reviewReplyUpdated",
        "reviewReplyPublicationCancelled",
        "staffAssigned",
        "staffUnassigned",
        "teamCreated",
        "teamDeleted",
        "teamUpdated"
      ]
    }
  ],
  "production": false,
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "unused-files": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-exports": "warn",
    "unused-types": "off"
  },
  "overrides": [
    {
      "files": [
        "server/plugins/production-secret-guard.ts",
        "server/plugins/restore-mode-guard.ts",
        "server/plugins/security-headers.ts",
        "server/plugins/request-guard.ts",
        "server/plugins/graceful-shutdown.ts",
        "src/contexts/identity/server/auth-settings.org.ts",
        "src/contexts/identity/server/organizations.roles.ts",
        "src/contexts/identity/server/policy-admin.ts",
        "src/contexts/identity/server/merchant-ai.ts",
        "src/contexts/property/server/region-move.ts"
      ],
      "rules": { "unused-files": "off" }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": { "unused-exports": "off", "unused-types": "off" }
    },
    {
      "files": ["**/*.dto.ts", "**/domain/events.ts"],
      "rules": { "unused-types": "off" }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 10
  },
  "health": {
    "maxCyclomatic": 22,
    "maxCognitive": 15,
    "maxCrap": 450
  },
  "audit": {
    "gate": "new-only"
  },
  "boundaries": {
    "zones": [
      { "name": "domain", "patterns": ["src/contexts/*/domain/**"] },
      { "name": "application", "patterns": ["src/contexts/*/application/**"] },
      { "name": "infrastructure", "patterns": ["src/contexts/*/infrastructure/**"] },
      { "name": "server", "patterns": ["src/contexts/*/server/**"] },
      { "name": "shared-testing", "patterns": ["src/shared/testing/**"] },
      { "name": "shared-events", "patterns": ["src/shared/events/**"] },
      { "name": "shared", "patterns": ["src/shared/**"] },
      { "name": "routes", "patterns": ["src/routes/**"] },
      { "name": "components", "patterns": ["src/components/**"] }
    ],
    "rules": [
      { "from": "domain", "allow": ["shared", "shared-events"] },
      { "from": "application", "allow": ["domain", "shared", "shared-events"] },
      {
        "from": "infrastructure",
        "allow": ["domain", "application", "shared", "shared-events"]
      },
      { "from": "server", "allow": ["application", "domain", "shared", "shared-events"] },
      {
        "from": "shared-testing",
        "allow": ["domain", "application", "shared", "shared-events"]
      },
      { "from": "shared-events", "allow": ["domain", "shared"] },
      { "from": "shared", "allow": ["shared-events"] }
    ]
  },
  "regression": {
    "baseline": {
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
