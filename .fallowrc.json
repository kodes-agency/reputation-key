      },
      {
        "files": ["src/contexts/portal/publication/portal-link-commands.server.ts"],
        "functions": ["assertPortalContentCommand"],
        "maxCyclomatic": 34,
        "reason": "This is the task brief's own canonical waiver shape: an exhaustive switch over a closed union of seven event tags, where each arm is a flat two-to-five-term conjunction that reads trivially. Cognitive is 10 \u2014 a third of the ceiling \u2014 which is the tell that the code is flat, not nested; only cyclomat"
      },
      {
        "files": ["src/contexts/reporting/readings/guest-outbox-consumers.server.ts"],
        "functions": ["guestMetricDomainEvent"],
        "maxCyclomatic": 38,
        "maxCognitive": 40,
        "reason": "This is the exhaustive-switch-over-a-closed-union archetype: eight sibling arms, each a guard plus an object literal, maximum nesting depth 2. I measured where the 38 cognitive points come from \u2014 33 of them are the +2/+3 nesting penalty applied to the single `if` inside each arm, not genuine interle"
      },
      {
        "files": ["src/contexts/feed/infrastructure/activity-outbox-consumers.ts"],
        "functions": ["mapRecentActivityFact"],
        "maxCyclomatic": 45,
        "reason": "cyclomatic=41 comes entirely from 40 sibling `case` arms of an exhaustive switch over the closed set of durable source-event types; cognitive=5 proves it is flat, not nested \u2014 each arm is an independent, trivially readable object literal, and the `default` arm throws on anything unregistered. Extrac"
      }
    ],
    "maxCrap": 450
  },
