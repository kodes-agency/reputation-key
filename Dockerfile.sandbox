# syntax=docker/dockerfile:1
ARG SOURCE_REVISION=unknown
# BQC-8: deterministic external provider sandbox. This bundles the existing
# dependency-free GBP/mail fixtures so a target cell can exercise its real
# provider adapters without granting live provider credentials.
FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS build

ENV PNPM_HOME=/pnpm \
    COREPACK_HOME=/opt/corepack \
    PATH=/pnpm:$PATH \
    HUSKY=0

RUN mkdir -p "$COREPACK_HOME" \
    && corepack enable \
    && corepack install --global pnpm@10.6.5
WORKDIR /app
RUN node -e "const expected={node:'22.23.2',icu:'78.2',unicode:'17.0'}; for (const [key,value] of Object.entries(expected)) if (process.versions[key] !== value) throw new Error(key+' runtime drift')"

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY e2e/fixtures/gbp-stub.ts e2e/fixtures/mail-stub.ts e2e/fixtures/ai-provider-stub.ts ./e2e/fixtures/
COPY scripts/perf/cell-stub-server.ts ./scripts/perf/cell-stub-server.ts

RUN pnpm exec tsup scripts/perf/cell-stub-server.ts \
    --format esm \
    --platform node \
    --target node22 \
    --out-dir dist \
    --clean

FROM node:22-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS runtime
ARG SOURCE_REVISION
ENV NODE_ENV=production \
    IMAGE_SOURCE_REVISION=$SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
WORKDIR /app
COPY --from=build --chown=node:node /app/dist/cell-stub-server.js ./provider-sandbox.mjs

USER node
EXPOSE 3000
CMD ["sh", "-c", "node provider-sandbox.mjs --kind=${BQC_STUB_KIND:-gbp} --port=${PORT:-3000}"]
